table mart_product_sales
	lineageTag: 01b0681a-c22b-497c-8b27-27f0b5479e3c

	measure 'Product Revenue' = CALCULATE(SUM(mart_product_sales[item_price]), mart_product_sales[status] = "delivered")
		lineageTag: 4ff9554a-9d3e-4988-a323-516ca13dcd5e

	measure 'Product Freight' = CALCULATE(SUM(mart_product_sales[freight_value]), mart_product_sales[status] = "delivered")
		lineageTag: 4618a247-1bd1-47ec-a3a2-8461ebad02a6

	measure 'Product Items Sold' = CALCULATE(COUNTROWS(mart_product_sales), mart_product_sales[status] = "delivered")
		lineageTag: 409d3b37-e878-4553-b6fc-2506205bf179

	measure 'Product Orders' = CALCULATE(DISTINCTCOUNT(mart_product_sales[order_id]), mart_product_sales[status] = "delivered")
		lineageTag: 7ad931a9-4655-4dde-8e99-c19f63dd88b9

	measure 'Category Revenue Share %' = DIVIDE([Product Revenue], CALCULATE([Product Revenue], ALLSELECTED(dim_products[category_name_en])))
		lineageTag: fd3922d3-9312-4fcb-b0e0-bad9eec47fcc

	measure 'Category Revenue Rank' = IF(ISINSCOPE(dim_products[category_name_en]), RANKX(ALLSELECTED(dim_products[category_name_en]), [Product Revenue], , DESC, DENSE))
		lineageTag: fed8d4e0-3df4-498e-9617-9a5af3c726a2

	measure 'Category Cumulative Revenue' = IF(ISINSCOPE(dim_products[category_name_en]), VAR CurrentRevenue = [Product Revenue] RETURN SUMX(FILTER(ALLSELECTED(dim_products[category_name_en]), [Product Revenue] >= CurrentRevenue), [Product Revenue]))
		lineageTag: 57d03599-4fe7-4ffa-9bf9-84c50ebc5294

	measure 'Category Cumulative Revenue %' = DIVIDE([Category Cumulative Revenue], CALCULATE([Product Revenue], ALLSELECTED(dim_products[category_name_en])))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: aa643c17-2f69-495c-a040-915b3a380342

	measure 'Category Pareto 80% Flag' = IF(ISINSCOPE(dim_products[category_name_en]) && [Category Cumulative Revenue %] - [Category Revenue Share %] < 0.8, 1, 0)
		lineageTag: 2f5ede12-813f-44db-b748-6b37c87fb269

	measure 'Average Product Description Length' = AVERAGE(dim_products[product_description_length])
		lineageTag: 9bf8f3fc-6f23-427e-bb81-ca6fe8e62d44

