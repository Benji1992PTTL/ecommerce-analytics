	partition mart_deliveries = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Projects\ecommerce-analytics\data\processed\powerbi\mart_deliveries.csv"), [Delimiter = ",", Columns = null, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
