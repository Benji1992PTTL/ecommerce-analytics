table mart_deliveries
	lineageTag: afc43b3a-9504-45a9-92b2-5c59689b3f6b

	measure 'Completed Deliveries' = CALCULATE(DISTINCTCOUNT(mart_deliveries[order_id]), mart_deliveries[status] = "delivered", NOT ISBLANK(mart_deliveries[delivered_at]))
		lineageTag: 1cd1cce2-cc0d-4f49-8f73-fd2f1f651e7a

	measure 'Average Delivery Days' = CALCULATE(AVERAGE(mart_deliveries[delivery_days]), mart_deliveries[status] = "delivered", NOT ISBLANK(mart_deliveries[delivered_at]))
		lineageTag: cb433c43-101d-42e0-8643-f5cdcbf0d419

	measure 'Late Deliveries' = CALCULATE([Completed Deliveries], mart_deliveries[is_late_delivery] = 1)
		lineageTag: 9b204dcd-e8e2-43fc-a68d-31db66961292

	measure 'On Time Deliveries' = CALCULATE([Completed Deliveries], mart_deliveries[is_late_delivery] = 0)
		lineageTag: fc41664c-09c8-4554-81d4-4c6a29b2c3f2

	measure 'Late Delivery Rate' = DIVIDE([Late Deliveries], [Late Deliveries] + [On Time Deliveries])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a9f987d5-c34d-4e44-8c69-324064ba860a

	measure 'On Time Delivery Rate' = DIVIDE([On Time Deliveries], [Late Deliveries] + [On Time Deliveries])
		lineageTag: d379babc-7644-482e-bd98-e7c6ddcc6cfa

	measure 'Average Delay Days (Late)' = CALCULATE(AVERAGE(mart_deliveries[days_vs_estimate]), mart_deliveries[is_late_delivery] = 1)
		lineageTag: 2aa337b0-8569-43ab-9a01-c22103001a3b

