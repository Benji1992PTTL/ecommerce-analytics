	partition mart_reviews = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Projects\ecommerce-analytics\data\processed\powerbi\mart_reviews.csv"), [Delimiter = ",", Columns = null, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"review_id", type text}, {"order_id", type text}, {"review_score", Int64.Type}, {"review_created_at", type datetime}, {"review_answered_at", type datetime}, {"status", type text}, {"purchased_at", type datetime}, {"delivered_at", type datetime}, {"estimated_delivery_at", type datetime}, {"state", type text}, {"city", type text}, {"is_late_delivery", Int64.Type}, {"customer_id", type text}, {"purchase_date", type date}}, "en-US")
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

