table mart_reviews
	lineageTag: 1d5c65b8-4cf7-48bd-b529-96ff38c7f79f

	measure 'Review Count' = COUNTROWS(mart_reviews)
		lineageTag: 69672f32-8c6b-4b45-b4fe-4c1117ee496e

	measure 'Reviewed Orders' = DISTINCTCOUNT(mart_reviews[order_id])
		lineageTag: ac7dadca-21af-4b1b-841c-ea98ba6b2fe7

	measure 'Average Review Score' = AVERAGE(mart_reviews[review_score])
		lineageTag: 4d48a13c-ae1b-4e83-a5f5-23551129cca6

	measure 'Positive Reviews %' = DIVIDE(CALCULATE([Review Count], mart_reviews[review_score] >= 4), [Review Count])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 49ae9f11-ce41-40f3-ad1b-9caa062dd814

	measure 'Low Reviews %' = DIVIDE(CALCULATE([Review Count], mart_reviews[review_score] <= 2), [Review Count])
		lineageTag: 8c2555ce-f36d-460b-83cd-3bf01790e40f

	measure 'Average Score On Time' = CALCULATE([Average Review Score], mart_reviews[is_late_delivery] = 0)
		lineageTag: 766cc1f2-daab-4a32-9887-754d78b84de9

	measure 'Average Score Late' = CALCULATE([Average Review Score], mart_reviews[is_late_delivery] = 1)
		lineageTag: ddb0ed46-88f3-419d-aa69-b22182093855

	column customer_id
		dataType: string
		lineageTag: 48d41dec-c116-4af0-ab48-3bdf986b9750
		summarizeBy: none
		sourceColumn: customer_id

	column purchase_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 0d2a37bc-f087-4ea0-8d6f-5ab8031251b8
		summarizeBy: none
		sourceColumn: purchase_date

		annotation UnderlyingDateTimeDataType = Date

	column review_id
