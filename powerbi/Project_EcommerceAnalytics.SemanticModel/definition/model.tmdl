model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-PT
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Fact Tables'

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["mart_order_sales","mart_deliveries","mart_payments","mart_product_sales","mart_reviews","dim_sellers","dim_products","dim_customers"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table mart_order_sales
ref table mart_deliveries
ref table mart_payments
ref table mart_product_sales
ref table mart_reviews
ref table dim_sellers
ref table dim_products
ref table dim_customers
ref table dim_calendar

ref cultureInfo en-US

